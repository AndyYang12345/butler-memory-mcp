# Butler Memory MCP bridge configuration.
# The database URL points at the same PostgreSQL the parent
# ai-butler-framework uses; the bridge acts as one durable device principal.

AI_BUTLER_DATABASE_URL=postgresql+asyncpg://ai_butler:change-me@127.0.0.1:5432/ai_butler

# From `ai-butler-admin bootstrap` output:
AI_BUTLER_MCP_USER_ID=00000000-0000-0000-0000-000000000000
# Register the bridge once as a device of that user:
#   ai-butler-admin add-device --user-id <USER_UUID> \
#     --device-name dsh-agent --device-kind agent \
#     --scope memory:read --scope memory:write
# then use the printed device_id (NOT the credential_id):
AI_BUTLER_MCP_DEVICE_ID=00000000-0000-0000-0000-000000000000

# Panel HTTP API (loopback only):
AI_BUTLER_MCP_BIND=127.0.0.1
AI_BUTLER_MCP_PORT=8771
